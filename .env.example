# Public site URL, used for canonical links and Open Graph tags.
VITE_SITE_URL=https://sm-studio-eight.vercel.app

# International format without "+" (e.g. 8801XXXXXXXXX). Empty hides WhatsApp UI.
VITE_WHATSAPP_NUMBER=

# Contact email. Empty hides email UI.
VITE_CONTACT_EMAIL=

# Optional social links. Empty hides the related footer icons.
VITE_FACEBOOK_URL=
VITE_YOUTUBE_URL=

# Optional form endpoint (Formspree, Basin, custom API). Empty shows the
# WhatsApp/email fallback after the inquiry is prepared.
VITE_FORM_ENDPOINT=
